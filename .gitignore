# ============================================================
#  美食地图 Foodie Trail — Git 忽略规则
#  原则：非必要不上传。运行时数据 / 密钥 / 依赖 / 缓存 一律忽略。
#  完整说明见 UPLOAD_RULES.md
#  修改本文件前请先确认（以免误传数据或密钥）
# ============================================================

# ---------- 运行时数据（本地私有，绝不入库） ----------
# data/ 内含：foodmap.db(数据库)、.fernet.key(加密密钥)、photos/(照片)
# 整目录忽略，最省心也最安全
data/

# ---------- 本地临时工作目录（最容易误传的一类） ----------
# .tmp-src/ 曾是「复制一份真实库 + 导出 backup.json + 照片」的验证目录，
# 里面含真实店名、备注与私人照片。这类目录一律按名字忽略，不靠人工记忆。
.tmp-*/
.tmp/
tmp/
tmp-*/

# ---------- 备份文件（含全部记录与内联照片，属私人数据） ----------
foodmap-backup-*.json
backup*.json

# ---------- 密钥 / 环境变量 / 凭证 ----------
.env
.env.*
*.local
*.key
*.pem
*.p12
secrets.*
credentials.*

# ---------- Python 虚拟环境 & 缓存 ----------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# ---------- 打包 / 构建产物（本地打包留下的东西一律不上传） ----------
build/
dist/
*.spec
# 例外：打包配置本身要进仓库，CI 靠它构建
!FoodieTrail.spec
*.exe
*.msi
*.zip
# Inno Setup 输出 / 发布产物
installer/Output/
release/

# ---------- Android 本地构建 ----------
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
android/*.jks
android/*.keystore
android/app/release/
# 打包产物：APK 体积 40MB+，不进仓库，随 Release 分发
android/dist/
*.apk
*.aab

# ---------- 编辑器 & 系统 ----------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- WorkBuddy 工作数据（AI 记忆/中间产物，不上传） ----------
.workbuddy/

# ---------- 日志 & 临时文件 ----------
*.log
*.tmp
*.temp
*.bak
*.orig

# ---------- 开发上下文（人类/AI 文档，含内部细节，绝不入库） ----------
dev-context/

# ---------- 本地协作说明（只在本机使用，不属于项目内容） ----------
UPLOAD_RULES.md

# ---------- 本地交互方案与原型页（自包含 HTML，不属于项目内容） ----------
docs/ux/
